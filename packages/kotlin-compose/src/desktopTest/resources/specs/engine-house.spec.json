{
  "spec_version": 1,
  "renderer_min": 1,
  "root": {
    "id": "engine-house", "type": "column", "props": { "gap": 8, "padding": 8 },
    "children": [
      {
        "id": "house", "type": "scene",
        "props": {
          "flex": 3,
          "view_state": { "renderer": "structure" },
          "scene_view": "{house.scene}",
          "view": "{house.view}",
          "highlight": "{bom.picked}",
          "selected": "{house.selected}",
          "focus": "{house.focus}",
          "show_lower": "{house.show_lower}",
          "hide_top": "{house.hide_top}",
          "color_by": {
            "channel": "utilisation",
            "stops": [
              { "up_to": 0.25, "color": "#20b620", "label": "under 25%" },
              { "up_to": 1, "color": "#b6b620", "label": "up to 100%" },
              { "color": "#7b1d72", "label": "over 100%" }
            ],
            "unknown_color": "#8b949c",
            "unknown_label": "no figure",
            "format": "percent"
          }
        }
      },
      {
        "id": "levels", "type": "row", "props": { "gap": 8, "align": "center" },
        "children": [
          {
            "id": "level-focus", "type": "select",
            "props": {
              "flex": 1, "value": "{house.focus}", "placeholder": "All levels",
              "options": [
                { "label": "All levels", "value": "all" },
                { "label": "Piers (level 0)", "value": "0" },
                { "label": "Beams (level 1)", "value": "1" },
                { "label": "Panels (level 2)", "value": "2" }
              ]
            }
          },
          {
            "id": "level-hide", "type": "select",
            "props": {
              "flex": 1, "value": "{house.hide_top}", "placeholder": "Hide nothing",
              "options": [
                { "label": "Hide nothing", "value": "0" },
                { "label": "Hide the panels", "value": "1" },
                { "label": "Hide the panels and beams", "value": "2" }
              ]
            }
          },
          { "id": "level-lower", "type": "toggle", "props": { "flex": 1, "label": "Show levels below", "value": "{house.show_lower}" } }
        ]
      },
      {
        "id": "bom-head", "type": "row", "props": { "gap": 8, "padding": 8 },
        "children": [
          { "id": "bom-head-part", "type": "text", "props": { "value": "Part", "bold": true, "flex": 4 } },
          { "id": "bom-head-quantity", "type": "text", "props": { "value": "Qty", "bold": true, "flex": 1 } },
          { "id": "bom-head-each", "type": "text", "props": { "value": "Each", "bold": true, "flex": 2 } },
          { "id": "bom-head-total", "type": "text", "props": { "value": "Total", "bold": true, "flex": 2 } },
          { "id": "bom-head-weight", "type": "text", "props": { "value": "Weight", "bold": true, "flex": 3 } }
        ]
      },
      {
        "id": "bom", "type": "list",
        "props": {
          "flex": 2,
          "data": "{reports.bom.rows}",
          "emptyText": "The engine sent no bill of materials.",
          "itemTemplate": {
            "id": "bom-row", "type": "card",
            "props": { "padding": 8 },
            "action": { "action": "set_binding", "params": { "path": "bom.picked", "value": "{row.object_ids}" } },
            "children": [
              {
                "id": "bom-row-line", "type": "row", "props": { "align": "center", "gap": 8 },
                "children": [
                  { "id": "bom-row-part", "type": "text", "props": { "value": "{row.label}", "flex": 4 } },
                  { "id": "bom-row-quantity", "type": "text", "props": { "value": "{row.values.quantity}", "flex": 1 } },
                  { "id": "bom-row-each", "type": "text", "props": { "value": "{row.values.unit_cost_usd}", "format": "usd", "flex": 2 } },
                  { "id": "bom-row-total", "type": "text", "props": { "value": "{row.values.line_usd}", "format": "usd", "flex": 2 } },
                  { "id": "bom-row-weight", "type": "text", "props": { "value": "{row.values.weight_kg}", "format": "pounds", "missing": "weight not known", "flex": 3 } }
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
