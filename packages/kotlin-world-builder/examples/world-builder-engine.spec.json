{
  "spec_version": 1,
  "renderer_min": 1,
  "root": {
    "id": "world-builder",
    "type": "row",
    "props": {
      "theme": "{theme}",
      "background": "ground",
      "flex": 1
    },
    "children": [
      {
        "id": "stage",
        "type": "column",
        "props": {
          "flex": 3
        },
        "children": [
          {
            "id": "toolbar",
            "type": "row",
            "props": {
              "padding": 8,
              "gap": 8,
              "align": "center"
            },
            "children": [
              {
                "id": "theme-label",
                "type": "text",
                "props": {
                  "value": "Theme",
                  "variant": "label"
                }
              },
              {
                "id": "theme-select",
                "type": "select",
                "props": {
                  "flex": 1,
                  "value": "{theme}",
                  "options": [
                    {
                      "label": "light",
                      "value": "light"
                    },
                    {
                      "label": "dark",
                      "value": "dark"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "terrain-bar",
            "type": "row",
            "visible": "{terrain}",
            "props": {
              "padding": 8,
              "gap": 8,
              "align": "center"
            },
            "children": [
              {
                "id": "terrain-label",
                "type": "text",
                "props": {
                  "value": "Terrain",
                  "variant": "label"
                }
              },
              {
                "id": "terrain-mode-select",
                "type": "select",
                "props": {
                  "flex": 1,
                  "value": "{terrain_mode}",
                  "placeholder": "off",
                  "options": [
                    {
                      "label": "off",
                      "value": "off"
                    },
                    {
                      "label": "hillshade",
                      "value": "hillshade"
                    },
                    {
                      "label": "height heat map",
                      "value": "heat"
                    },
                    {
                      "label": "cut and fill",
                      "value": "cutfill"
                    }
                  ]
                }
              },
              {
                "id": "contour-interval-label",
                "type": "text",
                "props": {
                  "value": "Contour interval",
                  "variant": "label"
                }
              },
              {
                "id": "contour-interval-select",
                "type": "select",
                "props": {
                  "flex": 1,
                  "value": "{contour_interval_mm}",
                  "placeholder": "50 mm",
                  "options": [
                    {
                      "label": "25 mm",
                      "value": "25"
                    },
                    {
                      "label": "50 mm",
                      "value": "50"
                    },
                    {
                      "label": "100 mm",
                      "value": "100"
                    },
                    {
                      "label": "250 mm",
                      "value": "250"
                    },
                    {
                      "label": "500 mm",
                      "value": "500"
                    }
                  ]
                }
              },
              {
                "id": "contours-label",
                "type": "text",
                "props": {
                  "value": "Contours",
                  "variant": "label"
                }
              },
              {
                "id": "contours-toggle",
                "type": "toggle",
                "props": {
                  "flex": 0.4,
                  "value": "{contours}"
                }
              }
            ]
          },
          {
            "id": "brush-line",
            "type": "text",
            "props": {
              "value": "Brush: {brush_label}. Tap a tile to place it, tap the same tile again to remove it.",
              "variant": "subheading"
            }
          },
          {
            "id": "world",
            "type": "tilemap",
            "props": {
              "flex": 1,
              "view": "{parcel.view}",
              "controlled": "{controlled}",
              "animate": "{animate}",
              "cols": "{parcel.cols}",
              "rows": "{parcel.rows}",
              "tile_area": "{parcel.tile_area}",
              "uses": "{uses}",
              "cells": "{cells}",
              "footprints": "{footprints}",
              "instances": "{instances}",
              "selected_use": "{brush}",
              "on_tile_tap": "world.tileTapped",
              "on_instance_tap": "world.instanceTapped",
              "palette": "top",
              "brush_label": "{brush_label}",
              "terrain": "{terrain}",
              "terrain_mode": "{terrain_mode}",
              "contours": "{contours}",
              "contour_interval_mm": "{contour_interval_mm}",
              "view_state": "{view_state}",
              "look": "{look}"
            }
          }
        ]
      },
      {
        "id": "panel",
        "type": "scrollview",
        "props": {
          "flex": 1,
          "background": "surface"
        },
        "children": [
          {
            "id": "panel-body",
            "type": "column",
            "props": {
              "padding": 14,
              "gap": 6,
              "background": "surface"
            },
            "children": [
              {
                "id": "panel-title",
                "type": "text",
                "props": {
                  "value": "World builder",
                  "variant": "heading"
                }
              },
              {
                "id": "panel-grid",
                "type": "text",
                "props": {
                  "value": "{parcel.cols} x {parcel.rows} tiles, {parcel.tile_area} sq ft each",
                  "variant": "caption"
                }
              },
              {
                "id": "branch-line",
                "type": "text",
                "props": {
                  "value": "{branch_line}",
                  "variant": "subheading"
                }
              },
              {
                "id": "plan-list",
                "type": "list",
                "props": {
                  "data": "{plans}",
                  "itemTemplate": {
                    "id": "plan-row",
                    "type": "row",
                    "props": {
                      "gap": 8,
                      "align": "center"
                    },
                    "children": [
                      {
                        "id": "plan-pick",
                        "type": "button",
                        "props": {
                          "label": "{item.label}"
                        },
                        "action": {
                          "action": "world.switchPlan",
                          "params": {
                            "id": "{item.id}"
                          }
                        }
                      },
                      {
                        "id": "plan-status",
                        "type": "text",
                        "props": {
                          "value": "{item.status}",
                          "variant": "caption"
                        }
                      }
                    ]
                  },
                  "stacked": true
                }
              },
              {
                "id": "branch-controls",
                "type": "row",
                "props": {
                  "gap": 8
                },
                "children": [
                  {
                    "id": "btn-proposal",
                    "type": "button",
                    "props": {
                      "label": "New alternative"
                    },
                    "action": {
                      "action": "world.newProposal"
                    }
                  },
                  {
                    "id": "btn-undo",
                    "type": "button",
                    "props": {
                      "label": "Undo"
                    },
                    "action": {
                      "action": "world.undo"
                    }
                  },
                  {
                    "id": "btn-save",
                    "type": "button",
                    "props": {
                      "label": "Save plan"
                    },
                    "action": {
                      "action": "world.savePlan"
                    }
                  }
                ]
              },
              {
                "id": "rename-row",
                "type": "row",
                "props": {
                  "gap": 8,
                  "align": "center"
                },
                "children": [
                  {
                    "id": "rename-input",
                    "type": "textinput",
                    "props": {
                      "value": "{rename_draft}",
                      "placeholder": "Name this plan",
                      "flex": 1
                    }
                  },
                  {
                    "id": "btn-rename",
                    "type": "button",
                    "props": {
                      "label": "Rename"
                    },
                    "action": {
                      "action": "world.renamePlan",
                      "params": {
                        "name": "{rename_draft}"
                      }
                    }
                  }
                ]
              },
              {
                "id": "diff-text",
                "type": "text",
                "props": {
                  "value": "{diff_text}",
                  "variant": "caption"
                }
              },
              {
                "id": "compare-title",
                "type": "text",
                "visible": "{compare_title}",
                "props": {
                  "value": "{compare_title}",
                  "variant": "subheading"
                }
              },
              {
                "id": "compare-text",
                "type": "text",
                "visible": "{compare_text}",
                "props": {
                  "value": "{compare_text}"
                }
              },
              {
                "id": "message-text",
                "type": "text",
                "visible": "{message}",
                "props": {
                  "value": "{message}"
                }
              },
              {
                "id": "instance-title",
                "type": "text",
                "visible": "{instance_title}",
                "props": {
                  "value": "{instance_title}",
                  "variant": "subheading"
                }
              },
              {
                "id": "instance-text",
                "type": "text",
                "visible": "{instance_text}",
                "props": {
                  "value": "{instance_text}"
                }
              },
              {
                "id": "usage-title",
                "type": "text",
                "props": {
                  "value": "On the parcel",
                  "variant": "subheading"
                }
              },
              {
                "id": "usage-text",
                "type": "text",
                "props": {
                  "value": "{usage_text}"
                }
              },
              {
                "id": "scores-title",
                "type": "text",
                "props": {
                  "value": "What the numbers say",
                  "variant": "subheading"
                }
              },
              {
                "id": "scores-hint",
                "type": "text",
                "props": {
                  "value": "Tap a figure to see what it means and where it comes from.",
                  "variant": "caption"
                }
              },
              {
                "id": "score-groups",
                "type": "list",
                "props": {
                  "data": "{score_groups}",
                  "itemTemplate": {
                    "id": "score-group",
                    "type": "column",
                    "props": {
                      "gap": 4
                    },
                    "children": [
                      {
                        "id": "score-group-title",
                        "type": "text",
                        "props": {
                          "value": "{item.title}",
                          "variant": "subheading"
                        }
                      },
                      {
                        "id": "score-rows",
                        "type": "list",
                        "props": {
                          "data": "{item.rows}",
                          "itemTemplate": {
                            "id": "score-row",
                            "type": "card",
                            "props": {
                              "padding": 8
                            },
                            "action": {
                              "action": "world.scoreTapped",
                              "params": {
                                "id": "{item.id}"
                              }
                            },
                            "children": [
                              {
                                "id": "score-line",
                                "type": "text",
                                "props": {
                                  "value": "{item.line}"
                                }
                              }
                            ]
                          },
                          "stacked": true
                        }
                      }
                    ]
                  },
                  "stacked": true
                }
              },
              {
                "id": "score-title",
                "type": "text",
                "visible": "{score_title}",
                "props": {
                  "value": "{score_title}",
                  "variant": "subheading"
                }
              },
              {
                "id": "score-text",
                "type": "text",
                "visible": "{score_text}",
                "props": {
                  "value": "{score_text}"
                }
              },
              {
                "id": "panel-hint",
                "type": "text",
                "props": {
                  "value": "click a tile to place the brush, click again to remove, drag to pan, scroll to zoom",
                  "variant": "caption"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}