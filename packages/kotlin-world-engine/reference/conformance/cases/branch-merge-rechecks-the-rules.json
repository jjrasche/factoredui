{
  "id": "branch-merge-rechecks-the-rules",
  "kind": "branching",
  "source": "hand",
  "world": {"file": "parcel-five-acre.frozen.world.json"},
  "input": {
    "steps": [
      {"do": "place", "parameters": {"type": "path", "col": 6, "row": 3}},
      {"do": "branch", "name": "idea", "from": "main"},
      {"do": "place", "on": "idea", "parameters": {"type": "van_pad", "col": 7, "row": 3}},
      {"do": "remove", "parameters": {"col": 6, "row": 3}},
      {"do": "merge", "branch": "idea"}
