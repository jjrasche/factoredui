{
  "id": "report-ground-merge-applies-both-digs",
  "kind": "report",
  "source": "hand",
  "world": {
    "file": "ground-plot.frozen.world.json"
  },
  "input": {
    "steps": [
      {
        "do": "branch",
        "name": "idea",
        "from": "main"
      },
      {
        "do": "dig",
        "parameters": {
          "col": 0,
          "row": 0,
          "depth_mm": 100
        },
        "on": "idea"
      },
      {
        "do": "dig",
        "parameters": {
          "col": 2,
          "row": 2,
          "depth_mm": 100
        }
      },
      {
        "do": "merge",
        "branch": "idea"
      }
    ]
  },
  "expect": {
    "steps": [
      {
        "applied": "e1"
      },
      {
        "applied": "e2"
      },
      {
        "applied": "e3"
      },
      {
        "applied": "e4"
      }
    ],
    "render": {
      "ground": {
        "heights_mm": [
          1200,
          1200,
          1300,
          1300,
          1300,
          1100,
          1100,
          1200,
          1200,
          1200,
          1100,
          1100,
          800,
          1000,
          1100,
          1000,
          1000,
          900,
          900,
          1000
        ],
        "version": 2
      }
    },
    "outputs": {
      "ground": {
        "version": 2,
        "min_mm": 800,
        "max_mm": 1300
      }
    }
  },
  "notes": "Tiles 0,0 and 2,2 share no vertex, so the merge applies the branch's dig on top of main's: version 1 after e3, 2 after the merge replays e2."
}
