      {"do": "place", "parameters": {"type": "paddock", "col": 9, "row": 12}},
      {"do": "place", "parameters": {"type": "path", "col": 6, "row": 0}},
      {"do": "place", "parameters": {"type": "pond", "col": 3, "row": 20}},
      {"do": "place", "parameters": {"type": "woodland_tree", "col": 10, "row": 22}}
